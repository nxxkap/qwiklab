{
  "name": "@poc/qwik-lib",
  "version": "0.0.0",
  "description": "Minimal Qwik component library fixture for tsdown adoption PoC",
  "main": "./lib/index.qwik.mjs",
  "qwik": "./lib/index.qwik.mjs",
  "types": "./lib-types/index.d.ts",
  "typesVersions": {
    "*": {
      "components": [
        "./lib-types/components.d.ts"
      ],
      "context": [
        "./lib-types/context.d.ts"
      ],
      "server": [
        "./lib-types/server.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./lib-types/index.d.ts",
        "default": "./lib/index.qwik.mjs"
      },
      "require": {
        "types": "./lib-types/index.d.cts",
        "default": "./lib/index.qwik.cjs"
      }
    },
    "./components": {
      "import": {
        "types": "./lib-types/components.d.ts",
        "default": "./lib/components.qwik.mjs"
      },
      "require": {
        "types": "./lib-types/components.d.cts",
        "default": "./lib/components.qwik.cjs"
      }
    },
    "./context": {
      "import": {
        "types": "./lib-types/context.d.ts",
        "default": "./lib/context.qwik.mjs"
      },
      "require": {
        "types": "./lib-types/context.d.cts",
        "default": "./lib/context.qwik.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./lib-types/server.d.ts",
        "default": "./lib/server.qwik.mjs"
      },
      "require": {
        "types": "./lib-types/server.d.cts",
        "default": "./lib/server.qwik.cjs"
      }
    }
  },
  "files": [
    "lib",
    "lib-types"
  ],
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "private": false,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "bun run build:vite",
    "build:vite": "vite build --mode lib && bun run build:types",
    "build:tsdown": "tsdown --config tsdown.direct.config.ts && bun run build:types",
    "build:vp": "vp pack && bun run build:types",
    "check": "tsc --noEmit",
    "build:types": "tsc --emitDeclarationOnly && bun run scripts/write-cjs-types.mjs",
    "validate": "bun run scripts/validate-package.mjs"
  },
  "peerDependencies": {
    "@builder.io/qwik": "^1.19.0"
  },
  "devDependencies": {
    "@builder.io/qwik": "1.20.0",
    "@tsdown/css": "0.22.3",
    "@types/node": "20.19.0",
    "tsdown": "^0.22.3",
    "typescript": "5.4.5",
    "vite": "7.3.1",
    "vite-plus": "^0.2.1",
    "vite-tsconfig-paths": "^4.2.1"
  }
}
