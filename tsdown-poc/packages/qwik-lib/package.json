{
  "name": "@poc/qwik-lib",
  "version": "0.0.0",
  "description": "Minimal Qwik component library fixture for tsdown adoption PoC",
  "main": "./lib/index.qwik.mjs",
  "qwik": "./lib/index.qwik.mjs",
  "types": "./lib-types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib-types/index.d.ts",
        "default": "./lib/index.qwik.mjs"
      },
      "require": {
        "types": "./lib-types/index.d.cts",
        "default": "./lib/index.qwik.cjs"
      }
    }
  },
  "files": [
    "lib",
    "lib-types"
  ],
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "private": false,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "bun run build:vite",
    "build:vite": "vite build --mode lib && bun run build:types",
    "check": "tsc --noEmit",
    "build:types": "tsc --emitDeclarationOnly && bun run scripts/write-cjs-types.mjs",
    "validate": "bun run scripts/validate-package.mjs"
  },
  "devDependencies": {
    "@builder.io/qwik": "1.20.0",
    "@types/node": "20.19.0",
    "typescript": "5.4.5",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "^4.2.1"
  }
}
