{
  "name": "@poc/qwik-lib",
  "version": "0.0.0",
  "description": "Minimal Qwik component library fixture for tsdown adoption PoC",
  "main": "./lib/index.qwik.mjs",
  "qwik": "./lib/index.qwik.mjs",
  "types": "./lib-types/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.qwik.mjs",
      "require": "./lib/index.qwik.cjs",
      "types": "./lib-types/index.d.ts"
    }
  },
  "files": [
    "lib",
    "lib-types"
  ],
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "private": false,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "build:types": "tsc --emitDeclarationOnly",
    "validate": "publint && attw --pack ."
  },
  "devDependencies": {
    "@builder.io/qwik": "1.20.0",
    "@types/node": "20.19.0",
    "typescript": "5.4.5",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "^4.2.1"
  }
}

